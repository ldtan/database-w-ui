{
  "name": "database-w-ui-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "capture:guide": "node scripts/capture-guide.mjs",
    "gen:api": "npm run gen:api:spec && openapi-typescript openapi.json -o src/lib/api-schema.ts",
    "gen:api:spec": "cd ../backend && uv run python -m src.infrastructure.export_openapi > ../frontend/openapi.json"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@hookform/resolvers": "^3.9.1",
    "@tanstack/react-query": "^5.102.8",
    "@types/leaflet": "^1.9.22",
    "html5-qrcode": "^2.3.8",
    "leaflet": "^1.9.4",
    "libphonenumber-js": "^1.13.12",
    "primeicons": "^7.0.0",
    "primereact": "^10.9.2",
    "quill": "^2.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-router-dom": "^7.18.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "openapi-typescript": "^7.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.0.5",
    "vitest": "^4.1.10"
  }
}
