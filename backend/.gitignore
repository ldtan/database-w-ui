# Environment variables
.env
.env.*
# ...except the template, which is the point of having one. `.env.*` above would
# otherwise swallow it and the file would be invisible to a fresh clone — which is
# exactly the failure the template exists to prevent.
!.env.example

# Local databases (SQLite)
*.db
*.sqlite
*.sqlite3

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Sensitive security keys
keys/