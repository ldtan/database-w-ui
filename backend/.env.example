# Copy to `.env` and fill in. Only the six below have no default and must be set —
# `Settings` refuses to construct without them, and it is built at import time, so a
# missing one is a startup failure rather than a later surprise.
#
# The full table of optional settings, with what each one buys, is in README.md.
# This file carries the shape, not the documentation.

# --- required ---------------------------------------------------------------

# Any long random string. Not the JWT signing key (that is the RSA pair below).
SECRET_KEY=change-me
# Mixed into password hashing. Changing it invalidates every stored password.
AUTH_SALT=change-me

# RS256 keypair. `keys/` is gitignored and nothing is committed there, so generate
# a pair first — `uv run python -m src.auth.keygen` writes to exactly these paths.
# Both are read at import time by src/auth/helpers.py.
RSA_PRIVATE_KEY_PATH=keys/private.pem
RSA_PUBLIC_KEY_PATH=keys/public.pem

# asyncpg, not psycopg: the `+asyncpg` is load-bearing. Over a network connection
# add `?ssl=require` — asyncpg does not understand libpq's `sslmode`.
DATABASE_URI=postgresql+asyncpg://postgres:postgres@localhost:5432/database_w_ui

# --- worth setting locally --------------------------------------------------

# The dev server's origin. Empty means no cross-origin requests are allowed, which
# is right in production (the SPA is served through a same-origin rewrite) and
# wrong the moment you point a local frontend at a remote API.
ALLOWED_ORIGINS=http://localhost:5173

DEBUG=true

# Seeded on first boot, only while the users table is empty. There is no public
# registration, so this is the account everything else is created from.
FIRST_SUPERUSER_USERNAME=admin
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=change-me

# Resolves every caller to the first user and skips authentication entirely.
# Local only — it is what lets the test suite run without tokens.
DISABLE_AUTH=false

# Address search proxies Nominatim. Leave it empty to turn address lookup off; the
# location picker still takes a typed address and a dropped pin. On a Windows dev
# box with a Python/OpenSSL mismatch, empty is the workaround — see known-gaps §13,
# where the failure is a process abort rather than an exception.
# GEOCODE_URL=https://nominatim.openstreetmap.org/search
